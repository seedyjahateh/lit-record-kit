# Copy to .env (gitignored) to use a live ServiceNow Personal Developer Instance.
SN_INSTANCE=https://devXXXXX.service-now.com
SN_USER=admin
# Wrap the password in single quotes: an unquoted '#' starts a comment and silently truncates it.
SN_PASSWORD='change-me'
# Tell the demo page to use the live Table API instead of mock data
VITE_USE_PDI=true
